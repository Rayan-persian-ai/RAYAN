{
  "name": "@rayan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.toml --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply rayan-db --local --config wrangler.dev.toml",
    "db:migrate:remote": "wrangler d1 migrations apply rayan-db --remote",
    "gen:agents-sql": "node scripts/gen-agents-sql.mjs",
    "deploy": "wrangler deploy",
    "dev:remote-ai": "wrangler dev --test-scheduled"
  },
  "dependencies": {
    "@rayan/shared": "*",
    "hono": "^4.13.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^4.20260702.1",
    "vitest": "~4.1.12",
    "wrangler": "^4.168.0"
  }
}
