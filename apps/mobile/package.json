{
  "name": "@rayan/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "RAYAN Android shell (Capacitor 6) wrapping apps/web/dist",
  "type": "module",
  "scripts": {
    "icons": "bash scripts/generate-assets.sh",
    "prepare:web": "node scripts/check-web-build.mjs",
    "sync": "npm run prepare:web && cap sync android && node scripts/post-sync.mjs",
    "android:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run sync && cd android && ./gradlew assembleRelease",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "~5.9.3"
  },
  "engines": { "node": ">=20" }
}
