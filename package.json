{
  "name": "rayan",
  "private": true,
  "version": "0.1.0",
  "description": "RAYAN — Persian-first AI platform (Phase 3: Cloudflare free-plan deploy + multi-provider AI router)",
  "workspaces": [
    "packages/shared",
    "packages/ai-router",
    "packages/cortex",
    "packages/autopilot",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @rayan/api",
    "dev:web": "npm run dev -w @rayan/web",
    "build:modules": "npm run build -w @rayan/cortex -w @rayan/autopilot"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
