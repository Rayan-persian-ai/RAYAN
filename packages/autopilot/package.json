{
  "name": "@rayan/autopilot",
  "version": "0.1.0",
  "description": "RAYAN AUTOPILOT — Persian-first marketing autopilot: Jalali event calendar, cron scheduler, campaign drafts with approval gates (Cloudflare Workers compatible)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "sql", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "examples:banners": "vitest run test/banner-files.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.7",
    "vitest": "^3.2.4"
  }
}
